# =========================
# OpenAI
# =========================
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =========================
# LangSmith
# =========================
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=IKEA_Hybrid_RAG

# =========================
# ChromaDB
# =========================
CHROMA_COLLECTION_NAME=ikea_faq
CHROMA_PERSIST_DIRECTORY=./chroma_db

# =========================
# RAG
# =========================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4

# =========================
# IKEA
# =========================
IKEA_ALLOWED_DOMAIN=ikea.com
IKEA_FAQ_URLS=https://www.ikea.com/us/en/customer-service/faq/