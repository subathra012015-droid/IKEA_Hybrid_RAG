# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=your-openai-chat-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model used for final candidate reranking.
# It can be the same model as OPENAI_CHAT_MODEL.
OPENAI_RERANK_MODEL=your-openai-chat-model


# ============================================================
# LangSmith
# ============================================================

LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=IKEA_Hybrid_RAG


# ============================================================
# ChromaDB
# ============================================================

CHROMA_COLLECTION_NAME=ikea_faq
CHROMA_PERSIST_DIRECTORY=./chroma_db


# ============================================================
# Chunking
# ============================================================

CHUNK_SIZE=1000
CHUNK_OVERLAP=150


# ============================================================
# Retrieval
# ============================================================

# Number of semantic candidates
SEMANTIC_TOP_K=8

# Number of BM25 candidates
BM25_TOP_K=8

# Number of candidates retained after fusion
FUSION_TOP_K=12

# Number of final results after reranking
RERANK_TOP_K=5

# RRF constant used when combining rankings
RRF_K=60


# ============================================================
# IKEA
# ============================================================

IKEA_ALLOWED_DOMAIN=ikea.com
IKEA_FAQ_URLS=https://www.ikea.com/us/en/customer-service/faq/

USER_AGENT=IKEA_Hybrid_RAG/1.0